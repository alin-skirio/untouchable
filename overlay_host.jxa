// Native AppKit overlay — same stack as the old welcome pill.
// argv: statePath, eventPath, logPath
// No WebKit. Polls a JSON file and keeps NSPanel frost cards on screen.

ObjC.import("Cocoa");

function logErr(path, msg) {
  try {
    var line = $.NSString.stringWithString(String(msg) + "\n");
    line.writeToFileAtomicallyEncodingError(path, true, $.NSUTF8StringEncoding, null);
  } catch (err) {}
}

function readState(path) {
  var str = $.NSString.stringWithContentsOfFileEncodingError(
    path,
    $.NSUTF8StringEncoding,
    null
  );
  if (!str) return null;
  try {
    return JSON.parse(ObjC.unwrap(str));
  } catch (err) {
    return null;
  }
}

function writeEvent(path, type) {
  var body = $.NSString.stringWithString(JSON.stringify({ type: type }));
  body.writeToFileAtomicallyEncodingError(path, true, $.NSUTF8StringEncoding, null);
}

function makeLabel(text, size, weight, alpha, align) {
  var field = $.NSTextField.alloc.initWithFrame($.NSMakeRect(0, 0, 40, 20));
  field.setBezeled(false);
  field.setBordered(false);
  field.setDrawsBackground(false);
  field.setEditable(false);
  field.setSelectable(false);
  field.setAlignment(align);
  field.setFont($.NSFont.systemFontOfSizeWeight(size, weight));
  field.setTextColor($.NSColor.colorWithWhiteAlpha(1, alpha));
  field.setStringValue(text);
  return field;
}

function makePanel(rect, radius, level) {
  var win = $.NSPanel.alloc.initWithContentRectStyleMaskBackingDefer(
    rect,
    128,
    2,
    false
  );
  win.setOpaque(false);
  win.setBackgroundColor($.NSColor.clearColor);
  win.setLevel(level);
  win.setHasShadow(false);
  win.setHidesOnDeactivate(false);
  win.setFloatingPanel(true);
  win.setBecomesKeyOnlyIfNeeded(true);
  win.setIgnoresMouseEvents(true);
  win.setCollectionBehavior(1 << 0 | 1 << 6 | 1 << 4);
  var fx = $.NSVisualEffectView.alloc.initWithFrame(
    $.NSMakeRect(0, 0, rect.size.width, rect.size.height)
  );
  fx.setMaterial(10);
  fx.setState(1);
  fx.setBlendingMode(0);
  fx.setWantsLayer(true);
  fx.layer.setCornerRadius(radius);
  fx.layer.setMasksToBounds(true);
  win.setContentView(fx);
  return { win: win, view: fx };
}

function place(field, x, y, w, h) {
  field.setFrame($.NSMakeRect(x, y, w, h));
}

function run(argv) {
  var statePath = argv && argv.length > 0 ? argv[0] : "";
  var eventPath = argv && argv.length > 1 ? argv[1] : "";
  var logPath = argv && argv.length > 2 ? argv[2] : "";
  if (!statePath) return;

  try {
    main(statePath, eventPath, logPath);
  } catch (err) {
    logErr(logPath, err);
  }
}

function main(statePath, eventPath, logPath) {
  var screen = $.NSScreen.mainScreen.frame;
  var xs = screen.origin.x;
  var ys = screen.origin.y;
  var sw = screen.size.width;
  var sh = screen.size.height;

  var intro = makePanel(screen, 0, 25);
  intro.win.setHasShadow(false);
  intro.win.setIgnoresMouseEvents(false);
  var welcome = makeLabel("Welcome", 56, -0.4, 0.94, 2);
  var deskReady = makeLabel("DESK READY", 11, 0.2, 0.28, 2);
  var clickHint = makeLabel("Click or Esc to continue", 12, 0.0, 0.28, 2);
  place(welcome, 0, sh / 2 - 10, sw, 70);
  place(deskReady, 0, sh / 2 - 42, sw, 20);
  place(clickHint, 0, 28, sw, 18);
  intro.view.addSubview(welcome);
  intro.view.addSubview(deskReady);
  intro.view.addSubview(clickHint);

  var chipW = 560;
  var chipH = 36;
  var chips = makePanel(
    $.NSMakeRect(xs + (sw - chipW) / 2, ys + sh - chipH - 22, chipW, chipH),
    18,
    8
  );
  var chipText = makeLabel("Unlocked", 13, 0.2, 0.9, 2);
  place(chipText, 10, 4, chipW - 20, 28);
  chips.view.addSubview(chipText);

  var barW = 720;
  var barH = 48;
  var bar = makePanel(
    $.NSMakeRect(xs + (sw - barW) / 2, ys + 22, barW, barH),
    20,
    8
  );
  var barText = makeLabel(
    "Pointer  open → fist → gun     Clicker  thumb + middle     Scroll  index / pinky     Switcher  pinch + flap     Voice  hey Grok",
    12,
    0.0,
    0.86,
    2
  );
  place(barText, 12, 8, barW - 24, 32);
  bar.view.addSubview(barText);

  var togW = 188;
  var togH = 32;
  var toggle = makePanel(
    $.NSMakeRect(xs + sw - togW - 18, ys + 16, togW, togH),
    16,
    9
  );
  toggle.win.setIgnoresMouseEvents(false);
  var togText = makeLabel("H · toggle HUD", 11, 0.1, 0.48, 2);
  place(togText, 8, 4, togW - 16, 24);
  toggle.view.addSubview(togText);

  intro.win.orderFrontRegardless();
  chips.win.orderFrontRegardless();
  bar.win.orderFrontRegardless();
  toggle.win.orderFrontRegardless();

  $.NSEvent.addLocalMonitorForEventsMatchingMaskHandler($.NSEventMaskLeftMouseDown, function (event) {
    if (intro.win.isVisible && !intro.win.ignoresMouseEvents) {
      writeEvent(eventPath, "dismiss_intro");
      return event;
    }
    try {
      var loc = $.NSEvent.mouseLocation;
      var frame = toggle.win.frame;
      var inside =
        loc.x >= frame.origin.x &&
        loc.x <= frame.origin.x + frame.size.width &&
        loc.y >= frame.origin.y &&
        loc.y <= frame.origin.y + frame.size.height;
      if (toggle.win.isVisible && inside) {
        writeEvent(eventPath, "toggle_hud");
      }
    } catch (err) {}
    return event;
  });

  var lastSig = "";
  while (true) {
    var state = readState(statePath);
    if (state && state.quit) break;

    var introOn = !!(state && state.intro);
    var hudOn = !!(state && state.hud);
    var locked = !!(state && (state.mode === "locked" || state.unlocked === false));
    var name = (state && (state.display_name || state.name)) || "";
    var sig = [introOn, hudOn, locked, name, !!(state && state.voice), !!(state && state.pointer)].join("|");

    if (sig !== lastSig) {
      lastSig = sig;
      welcome.setStringValue(name ? "Welcome " + name : "Welcome");
      if (locked) {
        chipText.setStringValue("Commands off · unfamiliar face");
        chipText.setTextColor($.NSColor.colorWithRedGreenBlueAlpha(0.98, 0.75, 0.14, 0.92));
      } else {
        var bits = ["Unlocked"];
        if (state && state.voice) bits.push("Voice listening");
        if (state && state.pointer) bits.push("Pointer armed");
        chipText.setStringValue(bits.join("     "));
        chipText.setTextColor($.NSColor.colorWithWhiteAlpha(1, 0.9));
      }
      togText.setStringValue(hudOn ? "H · toggle HUD   ON" : "H · toggle HUD");
      intro.win.setIsVisible(introOn);
      intro.win.setIgnoresMouseEvents(!introOn);
      chips.win.setIsVisible((hudOn && !introOn) || (locked && !introOn));
      bar.win.setIsVisible(hudOn && !introOn && !locked);
      toggle.win.setIsVisible(true);
    }

    $.NSRunLoop.currentRunLoop.runUntilDate($.NSDate.dateWithTimeIntervalSinceNow(0.12));
  }

  intro.win.orderOut(null);
  chips.win.orderOut(null);
  bar.win.orderOut(null);
  toggle.win.orderOut(null);
}
